# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# NEVER commit the real .env file.

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Secret used to sign JWT login tokens - use a long random string
JWT_SECRET=replace_this_with_a_long_random_string

# Port the backend server runs on
PORT=8082

# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# Razorpay TEST MODE keys (https://dashboard.razorpay.com/app/keys while Test Mode is ON)
# Only the backend may read these. Never put RAZORPAY_KEY_SECRET in frontend code.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx